# ---------------------------------------------------------------------------
# On-board (vehicle side) configuration.
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# SQLite file holding driver profiles and captured fault events.
DATABASE=db.sqlite

# The cloud backend that receives the condensed prompt and returns the
# personalized diagnosis.
BACKEND_URL=http://localhost:4000

# The on-board llama.cpp server (Gemma 3 1B) that condenses the driver
# profile + fault data into a short summary before transmission.
LLAMA_URL=http://localhost:8080
