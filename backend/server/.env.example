# ---------------------------------------------------------------------------
# Backend (cloud side) configuration.
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Postgres. Stores historical queries, knowledge entries, and feedback.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Qdrant vector database. Holds the two collections the RAG pipeline
# searches: historical queries and the knowledge base.
QDRANT_ENDPOINT=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=

# llama.cpp server started with --embedding. Turns query text into vectors
# for both historical-query matching and knowledge retrieval.
EMBEDDING_URL=http://localhost:5173
# Must match the embedding model's output dimension
# (Qwen3-Embedding-0.6B = 1024).
EMBEDDING_DIM=1024

# alpha in q_final = alpha*q_init + (1-alpha)*sum(z_k * q_k)
QUERY_AUGMENTATION_ALPHA=0.5
# K: number of same-prefix historical queries blended into the query.
HISTORICAL_QUERY_TOP_K=5
# Expert score (0-1) at which a query/response pair is fed back into the
# RAG knowledge base, independent of whether the driver found it helpful.
REINSERTION_EXPERT_SCORE_THRESHOLD=0.7

# Cloud response-generator LLM. Any OpenAI-compatible chat-completions
# endpoint works (Groq, OpenAI, together.ai, self-hosted llama.cpp/vLLM) —
# switching providers is three values, not a code change.
CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
CLOUD_LLM_MODEL=openai/gpt-oss-120b
CLOUD_LLM_API_KEY=
